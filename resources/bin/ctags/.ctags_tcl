--langdef=ZHDLTcl
--langmap=ZHDLTcl:.tcl
--regex-ZHDLTcl=/^[ \t]*(proc)[ \t]+([^ \t]+[ \t]+(\{.*\}|[^ \t]+))[ \t]+\{.*/\2/x,functions/
--regex-ZHDLTcl=/^(set|variable)[ \t]+([^ \t]+)[ \t]+(.+)/\2/g,global,globals/
--regex-ZHDLTcl=/^[ \t]*(namespace)[ \t]+[^ \t]+[ \t]+([^ \t]+)[ \t]+(.+)/\2/n,namespaces/
--regex-ZHDLTcl=/^.+(set)[ \t]+([^ \t]+)[ \t]+(.+)/\2/v,variables,vars/
--regex-ZHDLTcl=/^.*(array set)[ \t]+([^ \t]+)[ \t]+(.+)/\2/a,arrays/
--regex-ZHDLTcl=/^[^\$]*(source)[ \t]+([^ \t]+)$/\2/s,sources/
--regex-ZHDLTcl=/^.*(package require)[ \t]+([^ \t]+)$/\2/k,packages/
--regex-ZHDLTcl=/^.*(st::)?addproc[ \t]+([^ \t]+)[ \t]+.*$/\2/u,tests/
--regex-ZHDLTcl=/^.*interp[ \t]+alias[ \t]+[^ \t]+[ \t]+(.+).*$/\1/i,aliases/
