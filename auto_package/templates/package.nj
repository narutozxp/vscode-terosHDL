{
{%- filter indent(width=4) %}
{% include 'info.nj' %}
{% endfilter %}
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "zhdl-project",
                    "title": "ZHDL",
                    "icon": "resources/images/zhdl-sidebar.svg"
                }
            ],
            "panel": [
                {
                    "id": "zhdl-messages-view",
                    "title": "ZHDL: log report",
                    "icon": "fancy.icon"
                },
                {
                    "id": "zhdl-timing-view",
                    "title": "ZHDL: Timing",
                    "icon": "fancy.icon"
                }
            ]
        },
        "views": {
            "zhdl-project": [
                {
                    "id": "zhdl-project",
                    "name": "Projects"
                },
                {
                    "id": "zhdl-view-source",
                    "name": "Files"
                },
                {
                    "id": "zhdl-view-dependency",
                    "name": "Hierarchy"
                },
                {
                    "id": "zhdl-view-watcher",
                    "name": "Watchers"
                },
                {
                    "id": "zhdl-view-tasks",
                    "name": "Tasks"
                },
                {
                    "id": "zhdl-view-runs",
                    "name": "Runs"
                },
                {
                    "id": "zhdl-view-output",
                    "name": "Outputs"
                },
                {
                    "id": "zhdl-view-ip-catalog",
                    "name": "IP Catalog"
                },
                {
                    "id": "zhdl-view-actions",
                    "name": "Configuration"
                }
            ],
            "zhdl-messages-view": [
                {
                    "type": "webview",
                    "id": "zhdl-report-logs",
                    "name": "Report Logs"
                }
            ],
            "zhdl-timing-view": [
                {
                    "type": "webview",
                    "id": "zhdl-view-timing",
                    "name": "Timing Report"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "zhdl-project",
                "contents": "No ZHDL project are open.\n[Add Project](command:zhdl.view.project.add)\nTo learn more about how to [setup a ZHDL project](https://terostechnology.github.io/terosHDLdoc/docs/project_configuration/)."
            },
            {
                "view": "zhdl-view-source",
                "contents": "Learn more about how to [add files and libraries to a project](https://terostechnology.github.io/terosHDLdoc/docs/project_configuration/sources)."
            },
            {
                "view": "zhdl-view-dependency",
                "contents": "Learn more about how to [setup ZHDL to compute Hierarchy](https://terostechnology.github.io/terosHDLdoc/docs/project_configuration/hierarchy)."
            },
            {
                "view": "zhdl-view-actions",
                "contents": "[Verify Setup](command:zhdl.verifySetup)\n[Open Global Settings Menu](command:zhdl.configuration.global)\n[Export Settings](command:zhdl.view.project.export_configuration)\n[Load Settings](command:zhdl.view.project.load_configuration)\n[Documentation](command:zhdl.documentation)"
            }
      ],
{% filter indent(width=8) %}
{% include 'grammar.nj' %},
{% include 'menu.nj' %},
{% include 'command.nj' %},
{% include 'language_and_snippet.nj' %},
{% endfilter %}
        "keybindings": [
            {
                "command": "zhdl.go_to_parent",
                "key": "alt+backspace",
                "mac": "command+delete",
                "when": "editorTextFocus"
            }
        ]
    },
{% filter indent(width=4) %}
{% include 'script.nj' %},
{% include 'dependencie.nj' %},
{% include 'devDependencie.nj' %}
{% endfilter %}
}
